DATABASE_URL=sqlite:///./grievance.db
JWT_SECRET=change-this-secret
JWT_ISSUER=nivarat-grievance-system
ACCESS_TOKEN_MINUTES=30
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
ENVIRONMENT=development
# Email notifications through the Brevo SMTP relay.
# SMTP_USER is the SMTP login, SMTP_PASS is the "xsmtpsib-..." key from Brevo
# (SMTP &gt; SMTP &amp; API), and SMTP_FROM must be a sender address verified in Brevo.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=AI Grievance Management System
# Set to true only when using port 465 (implicit TLS instead of STARTTLS).
SMTP_SECURE=false
ADMIN_REGISTRATION_ID=
OFFICER_WATER_ID=
OFFICER_ELECTRICITY_ID=
OFFICER_STREET_LIGHT_ID=
OFFICER_ROAD_ID=
OFFICER_HEALTHCARE_ID=
OFFICER_SANITATION_ID=
OFFICER_DRAINAGE_ID=
OFFICER_ENVIRONMENT_ID=
